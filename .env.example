# Public services run without account credentials. Use HTTPS in production.
PORT=4000
HAWCONNECT_WEB_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8081
# Public-source caches. Persist their directory in production.
HAWCONNECT_FOOD_SNAPSHOT_PATH=.cache/hamburg-food.json
HAWCONNECT_FOOD_REFRESH_MS=1800000
HAWCONNECT_ACADEMIC_CALENDAR_PATH=.cache/haw-academic-calendar.json
HAWCONNECT_EVENTS_SNAPSHOT_PATH=.cache/haw-events.json

# Optional HAWConnect accounts, separate from university credentials.
HAWCONNECT_ACCOUNTS_DATABASE_URL=
HAWCONNECT_ACCOUNT_SECRET=
HAWCONNECT_AUTH_ORIGIN=http://localhost:4000
HAWCONNECT_WEB_ORIGIN=http://localhost:3000
# Base64 of 32 random bytes; back up separately from the database.
HAWCONNECT_SYNC_ENCRYPTION_KEY=
HAWCONNECT_SMTP_HOST=
HAWCONNECT_SMTP_PORT=587
HAWCONNECT_SMTP_USER=
HAWCONNECT_SMTP_PASSWORD=
HAWCONNECT_MAIL_FROM=

# Legacy backend tables are retained for compatibility; not required by public scrapers.
DB_HOST=localhost
DB_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Dashboard (separate admin allowlist; empty denies all non-delegated users)
HAWCONNECT_DASH_ORIGIN=http://localhost:43127
HAWCONNECT_ADMIN_EMAILS=
