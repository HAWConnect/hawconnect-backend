{
    "name": "@hawconnect/backend",
    "module": "index.ts",
    "type": "module",
    "scripts": {
        "start": "bun run index.ts",
        "dev": "bun --hot run index.ts",
        "docs:dev": "magidoc dev -f config/api-docs/magidoc.mjs -m bun",
        "db:generate": "drizzle-kit generate",
        "migrate": "bun run ./src/db/migrate.ts",
        "admin:set-password": "bun run ./src/admin/set-password.ts",
        "admin:migrate": "bun run ./src/db/accounts/admin-migrate.ts",
        "accounts:migrate": "bun run ./src/db/accounts/migrate.ts",
        "codegen": "graphql-codegen --config codegen.ts",
        "codegen:hawconnect": "bun run codegen",
        "lint": "tsc --noEmit && biome check",
        "fmt": "biome check --fix",
        "fmt:unsafe": "biome check --fix --unsafe",
        "test": "bun test",
        "organizers:migrate": "bun run ./src/db/accounts/organizer-migrate.ts",
        "legal:migrate": "bun run ./src/db/accounts/legal-migrate.ts"
    },
    "peerDependencies": {
        "typescript": "^5.0.0"
    },
    "dependencies": {
        "@apollo/server": "^5.5.1",
        "@as-integrations/express5": "^1.1.2",
        "@better-auth/expo": "1.7.12",
        "axios": "^1.18.1",
        "better-auth": "1.7.12",
        "cheerio": "^1.1.2",
        "cors": "^2.8.5",
        "drizzle-orm": "^0.36.4",
        "express": "^5.2.1",
        "fetch-cookie": "^3.2.0",
        "graphql": "^16.12.0",
        "graphql-scalars": "^1.25.0",
        "graphql-tag": "^2.12.6",
        "he": "^1.2.0",
        "ical.js": "2.2.1",
        "jsonwebtoken": "^9.0.3",
        "jwk-to-pem": "^2.0.7",
        "moment": "^2.30.1",
        "moment-timezone": "^0.5.48",
        "node-cache": "^5.1.2",
        "nodemailer": "7.0.13",
        "pg": "8.16.3",
        "postgres": "^3.4.7",
        "sanitize-html": "^2.17.0",
        "xml-js": "^1.6.11"
    },
    "devDependencies": {
        "@0no-co/graphqlsp": "^1.15.2",
        "@biomejs/biome": "^2.3.10",
        "@commitlint/cli": "^19.8.1",
        "@commitlint/config-conventional": "^19.8.1",
        "@graphql-codegen/cli": "5.0.7",
        "@graphql-codegen/schema-ast": "^4.1.0",
        "@magidoc/cli": "^6.3.0",
        "@types/bun": "^1.3.4",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/he": "^1.2.3",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/jwk-to-pem": "^2.0.3",
        "@types/node": "^22.19.3",
        "@types/nodemailer": "7.0.11",
        "@types/pg": "8.15.5",
        "@types/sanitize-html": "^2.16.0",
        "concurrently": "^9.2.1",
        "cross-env": "^7.0.3",
        "drizzle-kit": "^0.28.1",
        "globals": "^15.15.0",
        "typescript": "^5.9.3"
    },
    "private": true,
    "overrides": {
        "proxy-addr": "2.0.8",
        "shell-quote": "1.12.0"
    }
}
